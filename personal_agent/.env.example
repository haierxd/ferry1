# Configure .env once. Startup reads it without changing it or calling DeepSeek.
# Nonempty values in this file take priority over terminal environment variables.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
# Optional direct-browser callers. The default webpage uses a same-origin proxy.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:4173,http://localhost:4173,http://127.0.0.1:3000,http://localhost:3000
